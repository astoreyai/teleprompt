{
  "name": "teleprompt",
  "version": "1.1.0",
  "description": "Read-only transparent teleprompter with file playback, cue points, and presentation controls",
  "main": "out/main/index.js",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Aaron Storey",
    "email": "astoreyai@users.noreply.github.com"
  },
  "homepage": "https://github.com/astoreyai/teleprompt",
  "repository": {
    "type": "git",
    "url": "https://github.com/astoreyai/teleprompt.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node scripts/check-release-qualification.mjs && vitest run",
    "test:watch": "node scripts/check-release-qualification.mjs && vitest",
    "test:coverage": "node scripts/check-release-qualification.mjs && vitest run --coverage",
    "test:e2e": "node scripts/run-packaged-tests.mjs",
    "test:soak": "node scripts/run-packaged-tests.mjs --repeat-each=3",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:release": "npm audit --audit-level=high && npm run typecheck && npm run test:coverage && npm run test:e2e",
    "package:dir": "electron-vite build && electron-builder --linux --dir && npm run verify:artifact",
    "package": "electron-vite build && electron-builder --linux",
    "package:appimage": "electron-vite build && electron-builder --linux AppImage",
    "package:deb": "electron-vite build && electron-builder --linux deb",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:artifact": "node scripts/verify-artifact.mjs release/linux-unpacked",
    "test:real": "node scripts/test-real.mjs",
    "test:stress": "node scripts/run-packaged-tests.mjs --config=playwright.stress.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "dompurify": "3.4.14",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "18.0.6",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.2",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.astoreyai.teleprompt",
    "productName": "Teleprompt",
    "copyright": "Copyright \u00a9 2026 Aaron Storey",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/.DS_Store"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.teleprompt.txt"
      },
      {
        "from": "build/AppRun",
        "to": "AppRun"
      }
    ],
    "asar": true,
    "afterPack": "build/after-pack.mjs",
    "asarUnpack": [
      "**/node_modules/pdf-parse/**",
      "**/node_modules/mammoth/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Transparent overlay teleprompter",
      "description": "Always-on-top transparent file teleprompter with playback pacing, cue points, multi-format reading (txt/md/rtf/docx/odt/pdf/html/fountain/srt/vtt), presentation controls, and configurable hotkeys.",
      "maintainer": "Aaron Storey <astoreyai@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libasound2 | libasound2t64",
        "libdrm2",
        "libgbm1",
        "libxcb-dri3-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "xdotool"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "txt",
        "name": "Plain text",
        "mimeType": "text/plain",
        "role": "Viewer"
      },
      {
        "ext": "md",
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": "rtf",
        "name": "Rich Text",
        "mimeType": "application/rtf",
        "role": "Viewer"
      },
      {
        "ext": "docx",
        "name": "Word document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Viewer"
      },
      {
        "ext": "odt",
        "name": "OpenDocument Text",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": "html",
        "name": "HTML",
        "mimeType": "text/html",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML",
        "mimeType": "text/html",
        "role": "Viewer"
      },
      {
        "ext": "fountain",
        "name": "Fountain screenplay",
        "mimeType": "text/plain",
        "role": "Viewer"
      },
      {
        "ext": "srt",
        "name": "SubRip subtitles",
        "mimeType": "application/x-subrip",
        "role": "Viewer"
      },
      {
        "ext": "vtt",
        "name": "WebVTT subtitles",
        "mimeType": "text/vtt",
        "role": "Viewer"
      }
    ]
  }
}
