#!/bin/sh
set -eu
# Resolve our own location; an inherited APPDIR must not select another executable.
app_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$app_dir/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Electron must find a working sandbox or fail visibly. Never disable it implicitly.
exec "$app_dir/teleprompt" "$@"
